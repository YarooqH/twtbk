{
  "manifest_version": 3,
  "name": "XMarks - Twitter Bookmark Manager",
  "version": "1.0.0",
  "description": "A privacy-first, local-first Chrome extension to search, tag, and organize your bookmarks.",
  "browser_specific_settings": {
    "gecko": {
      "id": "njihhmpheebijihkgehocbcfhpfhjnjk@xmarks"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.twitter.com/*",
    "*://*.x.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "XMarks - Twitter Bookmark Manager",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "js": ["src/content/index.ts"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src * data: blob:;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "wasm/*"
      ],
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ]
    }
  ]
}
