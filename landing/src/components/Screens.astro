---
import { base } from '../site';

// Real screenshots of the extension, captured by store-assets/capture.mjs with
// its fictional demo library. Regenerate with store-assets/marketing.mjs.
// Marker positions are percentages of the 1280x800 screenshot.
const views = [
  {
    id: 'library',
    tab: 'Your library',
    url: 'XMarks dashboard',
    src: 'screens/library',
    alt: 'The XMarks dashboard searching for “bread”: categories on the left, matching posts with notes and tags in the middle, settings on the right.',
    points: [
      { x: 41.2, y: 10.4, title: 'Search everything', body: 'Post text, authors, tags and your notes.' },
      { x: 17, y: 52.1, title: 'Categories', body: 'Color-coded, with a count on each.' },
      { x: 50, y: 66.5, title: 'Notes and tags', body: 'Remember why you saved it.' },
      { x: 88, y: 53.4, title: 'Make it yours', body: 'Accent color, theme and card density.' },
    ],
  },
  {
    id: 'save',
    tab: 'Saving on X',
    url: 'x.com/home',
    src: 'screens/timeline-popover',
    alt: 'A post on the X timeline with the XMarks book button in its action bar and the category menu open below it.',
    points: [
      { x: 57.2, y: 57.3, title: 'The book button', body: 'It sits in every post’s action bar.' },
      { x: 50, y: 80.8, title: 'Pick a category', body: 'Or create a new one on the spot.' },
      { x: 50.8, y: 96.5, title: 'Add a note', body: 'Saved with the post, searchable later.' },
    ],
  },
  {
    id: 'sync',
    tab: 'Syncing',
    url: 'x.com/i/bookmarks',
    src: 'screens/sync-panel',
    alt: 'The Sync Bookmarks button under X’s Post button, with the sync panel open and a Start Sync button.',
    points: [
      { x: 21, y: 57.1, title: 'One click', body: 'Sync Bookmarks sits under X’s Post button.' },
      { x: 25, y: 69, title: 'Skips duplicates', body: 'Only posts you don’t have yet are added.' },
      { x: 25, y: 83.1, title: 'Pause any time', body: 'Pick up where you left off later.' },
    ],
  },
];
---

<section class="screens container" id="screens" aria-labelledby="screens-title">
  <div class="head">
    <div class="intro">
      <h2 class="section-title" id="screens-title">See it in action</h2>
      <p>Real screens from the extension, not mockups.</p>
    </div>
    <div class="seg" role="tablist" aria-label="Screens" data-screen-tabs>
      {
        views.map((v, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${v.id}`}
            aria-controls={`panel-${v.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {v.tab}
          </button>
        ))
      }
    </div>
  </div>

  {
    views.map((v, i) => (
      <div class="panel" role="tabpanel" id={`panel-${v.id}`} aria-labelledby={`tab-${v.id}`} hidden={i !== 0} data-panel>
        <div class="window">
          <div class="bar" aria-hidden="true">
            <span class="dots"><i /><i /><i /></span>
            <span class="url">{v.url}</span>
          </div>
          <div class="shot">
            <img
              src={`${base}${v.src}.jpg`}
              srcset={`${base}${v.src}.jpg 1280w, ${base}${v.src}@2x.webp 2560w`}
              sizes="(max-width: 1200px) 100vw, 1136px"
              width="1280"
              height="800"
              alt={v.alt}
              loading="lazy"
              decoding="async"
            />
            {v.points.map((p, n) => (
              <span class="pin" style={`left:${p.x}%;top:${p.y}%`} data-pin={n} aria-hidden="true">
                {n + 1}
              </span>
            ))}
          </div>
        </div>
        <ol class="points">
          {v.points.map((p, n) => (
            <li data-point={n}>
              <span class="num" aria-hidden="true">{n + 1}</span>
              <span class="text">
                <b>{p.title}</b>
                <span>{p.body}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-screen-tabs] [role="tab"]'));

  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    }
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });

  // Hovering a point lights its marker on the screenshot, and the other way round.
  document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
    const light = (n: string | undefined, on: boolean) => {
      if (n === undefined) return;
      panel.querySelector(`[data-pin="${n}"]`)?.classList.toggle('is-on', on);
      panel.querySelector(`[data-point="${n}"]`)?.classList.toggle('is-on', on);
    };
    panel.querySelectorAll<HTMLElement>('[data-pin], [data-point]').forEach((el) => {
      const n = el.dataset.pin ?? el.dataset.point;
      el.addEventListener('mouseenter', () => light(n, true));
      el.addEventListener('mouseleave', () => light(n, false));
    });
  });
</script>

<style>
  .screens {
    padding-top: 24px;
    padding-bottom: 112px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .intro p {
    margin: 0;
    font-size: 17px;
    color: var(--muted);
  }

  .seg {
    display: flex;
    padding: 3px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--bg-2);
  }

  .seg button {
    height: 40px;
    padding: 0 18px;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .seg button:hover {
    color: var(--text);
  }

  .seg button[aria-selected='true'] {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 28px;
    animation: panel-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .panel[hidden] {
    display: none;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
  }

  .window {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    background: var(--bg-2);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 30px 80px -20px color-mix(in srgb, var(--accent) 35%, transparent),
      0 0 120px -40px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .bar {
    position: relative;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
  }

  .dots {
    position: absolute;
    left: 16px;
    display: flex;
    gap: 7px;
  }

  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .url {
    min-width: 0;
    max-width: 60%;
    padding: 4px 18px;
    border-radius: 9999px;
    background: var(--bg);
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .shot {
    position: relative;
    overflow: hidden;
    border-radius: 0 0 17px 17px;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .pin {
    position: absolute;
    width: 30px;
    height: 30px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-contrast);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.55), 0 4px 14px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s var(--spring);
  }

  /* A soft ring that breathes, so the markers read as live, not printed. */
  .pin::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0;
    animation: ring 2.4s ease-out infinite;
  }

  .pin.is-on {
    transform: translate(-50%, -50%) scale(1.2);
  }

  @keyframes ring {
    0% {
      opacity: 0.7;
      transform: scale(0.8);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  .points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .points li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 16px;
    transition: border-color 0.15s, background 0.15s;
  }

  .points li.is-on {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .num {
    flex: 0 0 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 15px;
  }

  .text span {
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .seg {
      width: 100%;
    }

    .seg button {
      flex: 1;
      padding: 0 8px;
      font-size: 13px;
    }

    .bar {
      height: 32px;
    }

    .dots i {
      width: 8px;
      height: 8px;
    }

    .url {
      font-size: 11px;
      padding: 2px 12px;
    }

    .pin {
      width: 20px;
      height: 20px;
      font-size: 11px;
      box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.55);
    }

    .pin::after {
      inset: -4px;
    }
  }
</style>
