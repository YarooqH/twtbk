---
---

<section id="comparison" class="comparison-section">
  <div class="section-header">
    <div class="badge-pill mb-3">
      <span class="badge-pill-dot"></span>
      <span>Competitive Advantage</span>
    </div>
    <h2 class="section-title">Why XMarks beats X Premium</h2>
    <p class="section-subtitle">
      Compare XMarks against native X bookmarks and paid X Premium features.
    </p>
  </div>

  <div class="table-wrap glass-panel">
    <table class="comparison-table">
      <thead>
        <tr>
          <th>Feature</th>
          <th>Native Free X</th>
          <th>X Premium ($8–$16/mo)</th>
          <th class="highlight-col">XMarks (100% Free)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Full-Text Content Search</td>
          <td class="cross">❌ No</td>
          <td class="cross">❌ No</td>
          <td class="check highlight-col">✅ Instant Search</td>
        </tr>
        <tr>
          <td>AI Auto-Categorization</td>
          <td class="cross">❌ No</td>
          <td class="cross">❌ No</td>
          <td class="check highlight-col">✅ Local On-Device AI</td>
        </tr>
        <tr>
          <td>Custom Notes on Tweets</td>
          <td class="cross">❌ No</td>
          <td class="cross">❌ No</td>
          <td class="check highlight-col">✅ Full Notes Support</td>
        </tr>
        <tr>
          <td>1-Click Bulk Importer</td>
          <td class="cross">❌ No</td>
          <td class="cross">❌ No</td>
          <td class="check highlight-col">✅ Automated Scroll Importer</td>
        </tr>
        <tr>
          <td>Offline JSON Backups</td>
          <td class="cross">❌ No</td>
          <td class="cross">❌ No</td>
          <td class="check highlight-col">✅ Export / Import Library</td>
        </tr>
        <tr>
          <td>Data Privacy Architecture</td>
          <td>Cloud Storage</td>
          <td>Cloud Storage</td>
          <td class="check highlight-col">✅ 100% Local IndexedDB</td>
        </tr>
        <tr>
          <td>Monthly Price</td>
          <td>Free</td>
          <td>$96–$192 / year</td>
          <td class="check highlight-col">✅ 100% Free Forever</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  .comparison-section {
    padding: 80px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .table-wrap {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .comparison-table th,
  .comparison-table td {
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .comparison-table th {
    background: var(--bg-tertiary);
    font-weight: 800;
    color: var(--text);
  }
  .highlight-col {
    background: rgba(29, 155, 240, 0.08) !important;
    font-weight: 700;
    color: var(--text) !important;
  }
  .check {
    color: var(--accent-green);
    font-weight: 700;
  }
  .cross {
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .table-wrap {
      overflow-x: auto;
    }
  }
</style>
