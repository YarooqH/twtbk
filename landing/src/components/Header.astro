---
---

<header class="header-container glass-panel">
  <div class="header-inner">
    <a href="#" class="logo-group">
      <div class="logo-icon-bg">
        <img src="/logo.svg" alt="XMarks Logo" width="20" height="20" />
      </div>
      <span class="logo-text">XMarks</span>
      <span class="logo-badge">v1.0.0</span>
    </a>

    <nav class="header-nav">
      <a href="#features" class="nav-link">Features</a>
      <a href="#demo" class="nav-link">Live Demo</a>
      <a href="#privacy" class="nav-link">Privacy</a>
      <a href="#comparison" class="nav-link">vs X Premium</a>
      <a href="#faq" class="nav-link">FAQ</a>
    </nav>

    <div class="header-actions">
      <a href="https://github.com/YarooqH/twtbk" target="_blank" rel="noopener noreferrer" class="github-btn" title="View Source on GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
      <a href="https://chromewebstore.google.com" target="_blank" rel="noopener noreferrer" class="btn-x-primary btn-sm">
        Add to Chrome
      </a>
    </div>
  </div>
</header>

<style>
  .header-container {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    border-bottom: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .header-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .logo-icon-bg {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .logo-icon-bg img {
    filter: brightness(0);
  }
  .logo-text {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--text);
  }
  .logo-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--bg-tertiary);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }
  .header-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .nav-link:hover {
    color: var(--text);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .github-btn {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border-radius: 50%;
    transition: all 0.15s;
  }
  .github-btn:hover {
    color: var(--text);
    background: var(--bg-tertiary);
  }
  .btn-sm {
    padding: 8px 18px !important;
    font-size: 14px !important;
  }

  @media (max-width: 768px) {
    .header-nav {
      display: none;
    }
  }
</style>
