---
---

<section class="hero-section">
  <div class="hero-container">
    <!-- Left Column: Giant XMarks Logo & Animated Aura -->
    <div class="hero-visual">
      <div class="glow-aura animate-glow"></div>
      <div class="logo-box">
        <div class="logo-circle">
          <img src="/logo.svg" alt="XMarks Logo" width="100" height="100" />
        </div>
      </div>
    </div>

    <!-- Right Column: High Impact Copy & CTAs -->
    <div class="hero-content">
      <div class="badge-pill mb-4">
        <span class="badge-pill-dot"></span>
        <span>Privacy-First • Local-First • On-Device AI</span>
      </div>

      <h1 class="hero-headline">
        Happening now<br />
        <span class="text-gradient">for your saved threads.</span>
      </h1>

      <h2 class="hero-subheadline">
        Your X Bookmarks, Organized.
      </h2>

      <p class="hero-description">
        Transform X's single chaotic bookmark list into an instant-searchable personal reference library. Categorize threads with custom tags, add private notes, and run local AI auto-categorization without sending a single byte of data to cloud servers.
      </p>

      <div class="hero-ctas">
        <a href="https://chromewebstore.google.com" target="_blank" rel="noopener noreferrer" class="btn-x-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
          </svg>
          Add to Chrome — It's Free
        </a>
        <a href="#demo" class="btn-x-outline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          Try Live Demo
        </a>
      </div>

      <!-- Key Highlights Bar -->
      <div class="hero-metrics">
        <div class="metric-item">
          <span class="metric-val">100%</span>
          <span class="metric-lbl">Local Privacy</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-val">0.0s</span>
          <span class="metric-lbl">Search Latency</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-val">$0</span>
          <span class="metric-lbl">Forever Free</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 80px 24px 100px;
    max-width: 1280px;
    margin: 0 auto;
    overflow: hidden;
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: center;
  }
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }
  .glow-aura {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(29, 155, 240, 0.35) 0%, rgba(0, 0, 0, 0) 70%);
    z-index: 0;
  }
  .logo-box {
    position: relative;
    z-index: 1;
  }
  .logo-circle {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 60px rgba(255, 255, 255, 0.25), 0 20px 40px rgba(0, 0, 0, 0.6);
    border: 4px solid rgba(255, 255, 255, 0.1);
  }
  .logo-circle img {
    filter: brightness(0);
    width: 100px;
    height: 100px;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .mb-4 {
    margin-bottom: 20px;
  }
  .hero-headline {
    font-size: 56px;
    font-weight: 900;
    letter-spacing: -1.5px;
    line-height: 1.08;
    margin-bottom: 12px;
  }
  .hero-subheadline {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 20px;
    letter-spacing: -0.5px;
  }
  .hero-description {
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 540px;
  }
  .hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }
  .hero-metrics {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    width: 100%;
    max-width: 520px;
  }
  .metric-item {
    display: flex;
    flex-direction: column;
  }
  .metric-val {
    font-size: 24px;
    font-weight: 800;
    color: var(--text);
    line-height: 1.1;
  }
  .metric-lbl {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 4px;
  }
  .metric-divider {
    width: 1px;
    height: 28px;
    background: var(--border);
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .hero-content {
      align-items: center;
    }
    .hero-headline {
      font-size: 42px;
    }
    .hero-subheadline {
      font-size: 22px;
    }
    .hero-description {
      text-align: center;
    }
    .hero-ctas {
      justify-content: center;
    }
    .hero-metrics {
      justify-content: center;
    }
  }
</style>
