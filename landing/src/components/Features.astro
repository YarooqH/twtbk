---
---

<section id="features" class="features-section">
  <div class="section-header">
    <h2 class="section-title">Built for Power Users on X</h2>
    <p class="section-subtitle">
      Stop losing threads in an unsearchable bookmark list. Here is how XMarks transforms your workflow.
    </p>
  </div>

  <div class="features-grid">
    <!-- Feature 1 -->
    <div class="feature-card glass-panel">
      <div class="feature-icon" style="background: rgba(29, 155, 240, 0.15); color: #1d9bf0;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </div>
      <h3 class="feature-title">1-Click Automated Importer</h3>
      <p class="feature-desc">
        Sync hundreds of saved bookmarks in under 60 seconds with an automated DOM scroll importer directly from x.com/i/bookmarks.
      </p>
    </div>

    <!-- Feature 2 -->
    <div class="feature-card glass-panel">
      <div class="feature-icon" style="background: rgba(120, 86, 255, 0.15); color: #7856ff;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2a10 10 0 1 0 10 10H12V2z"/>
          <path d="M12 12L2.1 12.1"/>
          <path d="M12 12l4.3-8.6"/>
        </svg>
      </div>
      <h3 class="feature-title">On-Device Local AI Worker</h3>
      <p class="feature-desc">
        Hugging Face Transformers.js runs inside your browser to auto-classify tweets without sending a single byte to external servers.
      </p>
    </div>

    <!-- Feature 3 -->
    <div class="feature-card glass-panel">
      <div class="feature-icon" style="background: rgba(0, 186, 124, 0.15); color: #00ba7c;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
      <h3 class="feature-title">Instant Full-Text Search</h3>
      <p class="feature-desc">
        Query tweet copy, author handles, custom notes, #tags, and article snippets with sub-millisecond local IndexedDB search.
      </p>
    </div>

    <!-- Feature 4 -->
    <div class="feature-card glass-panel">
      <div class="feature-icon" style="background: rgba(255, 212, 0, 0.15); color: #ffd400;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
      </div>
      <h3 class="feature-title">Custom Categories & Notes</h3>
      <p class="feature-desc">
        Organize threads into color-coded folders (Tech, Design, AI, Football) and attach personal notes for future reference.
      </p>
    </div>

    <!-- Feature 5 -->
    <div class="feature-card glass-panel">
      <div class="feature-icon" style="background: rgba(249, 24, 128, 0.15); color: #f91880;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
      </div>
      <h3 class="feature-title">Native X Button Override</h3>
      <p class="feature-desc">
        Seamlessly replace X's default bookmark action or place a dedicated XMarks button right beside Repost, Like, and Views.
      </p>
    </div>

    <!-- Feature 6 -->
    <div class="feature-card glass-panel">
      <div class="feature-icon" style="background: rgba(0, 196, 182, 0.15); color: #00c4b6;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
      </div>
      <h3 class="feature-title">Offline JSON Backups</h3>
      <p class="feature-desc">
        Never lose a thread if a tweet gets deleted or your account changes. Export and restore your complete library anytime.
      </p>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 80px 24px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
  }
  .feature-card {
    border-radius: var(--radius-xl);
    padding: 32px;
    transition: transform 0.2s, border-color 0.2s;
  }
  .feature-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }
  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .feature-title {
    font-size: 20px;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 10px;
    letter-spacing: -0.3px;
  }
  .feature-desc {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
